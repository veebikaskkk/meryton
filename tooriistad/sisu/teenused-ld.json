    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Millistes piirkondades te töötate?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Põhipiirkonnad on Pärnumaa, Viljandimaa ja Harjumaa. Oleme avatud koostööle üle Eesti, aga suuremal kaugusel tuleb logistika eraldi läbi rääkida."
          }
        },
        {
          "@type": "Question",
          "name": "Kas te teete ainult eramaju?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Fookuses on erasektor, eelkõige eramajad ja väiksemad arendusprojektid. Alltöövõtu korras oleme pinnakatteid paigaldanud ka kaubanduskeskustes, kinodes ja restoranides."
          }
        },
        {
          "@type": "Question",
          "name": "Kas vesi, kanalisatsioon ja küte tuleb eraldi mehe käest tellida?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Ei. Teeme eramute vee- ja kanalisatsioonitöid ise ning paigaldame kütte- ja ventilatsioonisüsteeme vastavalt projektile. Projekti ennast me ei koosta."
          }
        },
        {
          "@type": "Question",
          "name": "Mida tähendab Turvalise Partneri märgis?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Märgise annab Eesti Võlausaldajate Liit ja see puudutab ettevõtte maksekäitumist."
          }
        },
        {
          "@type": "Question",
          "name": "Kas te võtate ka alltöövõtutöid?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Jah. Pinnakatete paigaldust oleme alltöövõtu korras teinud Apollo kinodes ja raamatupoes ning mitmes restoranis Eestis, Lätis ja Leedus."
          }
        },
        {
          "@type": "Question",
